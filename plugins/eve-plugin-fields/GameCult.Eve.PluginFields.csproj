<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Runtime-neutral C# contracts for gamecult.fields documents.</Description>
    <CultLibRoot Condition="'$(CultLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\CultLib</CultLibRoot>
    <PackageId>GameCult.Eve.PluginFields</PackageId>
    <Version>0.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CultLibRoot)\src\GameCult.Caching\GameCult.Caching.csproj" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>
</Project>
